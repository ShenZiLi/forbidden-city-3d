{
  "name": "forbidden-city-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:browser:tabbit": "pwsh -NoProfile -File scripts/run-tabbit-tests.ps1",
    "validate": "npm run test && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/rapier": "2.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.183.2",
    "lucide-react": "0.577.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
